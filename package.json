{
  "name": "wagas-coletor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agregador de vagas: coletor (Serper) e classificador (pre-filtro + LLM)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "collect": "node --env-file-if-exists=.env src/collect.ts",
    "collect:dry": "node --env-file-if-exists=.env src/collect.ts --dry-run",
    "classify": "node --env-file-if-exists=.env src/classify.ts",
    "classify:dry": "node --env-file-if-exists=.env src/classify.ts --dry-run",
    "harness": "node --env-file-if-exists=.env scripts/harness.ts",
    "harness:prefiltro": "node scripts/harness.ts --so-prefiltro",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "paridade": "node --env-file-if-exists=.env scripts/paridade.ts",
    "passo1": "node --env-file-if-exists=.env scripts/comparar-passo1.ts",
    "alertas": "node --env-file-if-exists=.env scripts/medir-alertas.ts",
    "backfill": "node --env-file-if-exists=.env scripts/backfill-feed.ts",
    "feed": "node --env-file-if-exists=.env scripts/consultar-feed.ts",
    "web": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "telegram": "node --env-file-if-exists=.env scripts/testar-telegram.ts",
    "telegram:gupy": "node --env-file-if-exists=.env scripts/telegram-vs-gupy.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
