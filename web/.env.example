# Modelo de configuracao do front-end. Copie para .env.local.
# ESTE ARQUIVO VAI PARA O GIT: nunca colocar valor real aqui.

# A mesma URL do projeto usada pelo coletor.
NEXT_PUBLIC_SUPABASE_URL=

# Chave PUBLICA (publishable / anon). Vai para o navegador — e so pode ler o
# que a RLS permitir. NUNCA colocar aqui a sb_secret_... do coletor: ela ignora
# RLS e daria o acervo inteiro para qualquer visitante.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
