# Modelo de configuracao do front-end. Copie para .env.local.
# ESTE ARQUIVO VAI PARA O GIT: nunca colocar valor real aqui.

# A mesma URL do projeto usada pelo coletor.
NEXT_PUBLIC_SUPABASE_URL=

# Chave PUBLICA (publishable / anon). Vai para o navegador — e so pode ler o
# que a RLS permitir. NUNCA colocar aqui a sb_secret_... do coletor: ela ignora
# RLS e daria o acervo inteiro para qualquer visitante.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Coleta sob demanda (server-only) ----------------------------------------
# A MESMA sb_secret_ que o coletor usa. Sem o prefixo NEXT_PUBLIC_ de proposito:
# o bundler nunca a injeta no codigo do cliente. Ela ignora RLS, e existe aqui
# so porque a coleta sob demanda precisa GRAVAR em raw_results e jobs — dar essa
# permissao a chave publica deixaria qualquer visitante injetar vaga falsa.
# Sem esta variavel o feed continua funcionando: ele so le o cache.
SUPABASE_SERVICE_KEY=

# --- Medidor de curriculo (server-only) ---------------------------------------
# A mesma chave do Gemini que o classificador usa (tier gratuito). Sem ela a
# pagina /funcionalidades/ats abre, mas a medicao responde "fora do ar".
GEMINI_KEY=
# Opcional. Padrao: gemini-3.5-flash-lite.
GEMINI_MODELO=
# Opcional. Medicoes por dia: visitante anonimo (padrao 3) e conta com e-mail (padrao 10).
LIMITE_ATS_VISITANTE=
LIMITE_ATS_DIARIO=

# --- Outra fonte em segundo plano (server-only) --------------------------------
# Token do GitHub que so dispara workflow: fine-grained, so este repositorio,
# permissao "Actions: Read and write". A busca de par novo pede a coleta do
# InfoJobs pelo workflow outra-fonte.yml. Sem ele, o par novo recebe o InfoJobs
# so na coleta diaria seguinte, como antes.
GITHUB_DISPATCH_TOKEN=
# Opcional. Padrao: OrdepPedro/wagas.
GITHUB_REPO=
