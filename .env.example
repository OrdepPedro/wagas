# Modelo de configuracao. Copie para .env e preencha la.
# ESTE ARQUIVO VAI PARA O GIT: nunca colocar valor real aqui.

# --- Fonte de producao -------------------------------------------------------
# Serper.dev: 2.500 creditos gratuitos, uma vez so, validade de 6 meses.
# Saldo ACUMULADO: nao renova por dia. Consumo em .quota/serper.json (local)
# ou na tabela api_saldo, chave 'serper' (producao).
SERPER_KEY=

# --- Supabase ----------------------------------------------------------------
# service_role ignora RLS: so em secret do Actions e em .env local.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Opcionais ---------------------------------------------------------------
SERPER_CREDITOS_TOTAIS=2500   # saldo total contratado
SERPER_ORCAMENTO_POR_RUN=150  # teto por execucao: rodada com bug nao torra tudo
SERPER_PAGINAS=3              # paginas por consulta (10 resultados cada)
SERPER_INTERVALO_MS=200       # rate limit entre chamadas
SERPER_TENTATIVAS=3           # tentativas por consulta (1 + 2 retries)
LOG_LEVEL=info                # debug | info | warn | error
