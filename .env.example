# Modelo de configuracao. Copie para .env e preencha la.
# ESTE ARQUIVO VAI PARA O GIT: nunca colocar valor real aqui.

# --- Fonte de producao -------------------------------------------------------
# Serper.dev: 2.500 creditos gratuitos, uma vez so, validade de 6 meses.
# Saldo ACUMULADO: nao renova por dia. Consumo em .quota/serper.json (local)
# ou na tabela api_saldo, chave 'serper' (producao).
SERPER_KEY=

# --- Supabase ----------------------------------------------------------------
# service_role ignora RLS: so em secret do Actions e em .env local.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Opcionais ---------------------------------------------------------------
SERPER_CREDITOS_TOTAIS=2500   # saldo total contratado
SERPER_ORCAMENTO_POR_RUN=150  # teto por execucao: rodada com bug nao torra tudo
SERPER_PAGINAS=3              # paginas por consulta (10 resultados cada)
SERPER_INTERVALO_MS=200       # rate limit entre chamadas
SERPER_TENTATIVAS=3           # tentativas por consulta (1 + 2 retries)
LOG_LEVEL=info                # debug | info | warn | error

# --- Classificador (Passo 3) -------------------------------------------------
# Nenhuma das duas chaves e obrigatoria: sem chave, `npm run classify` faz so o
# pre-filtro e diz o que TERIA mandado para o modelo. Serve para conferir custo
# antes de gastar cota.
#
# Gemini Flash-Lite: tier gratuito, sem cartao. https://aistudio.google.com/apikey
GEMINI_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
# Groq: reserva para quando a cota diaria do Gemini estourar. https://console.groq.com/keys
GROQ_KEY=
GROQ_MODELO=llama-3.3-70b-versatile

CLASSIFICADOR_LOTE=8                 # candidatos por chamada de LLM
CLASSIFICADOR_LIMITE=200             # maximo de pendentes por execucao
CLASSIFICADOR_CONFIANCA_MINIMA=0.6   # abaixo disso a vaga nao entra no feed
